<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>
			{% block title %}DTFcrowd
			{% endblock %}
		</title>
		<link rel="icon" href="{{ asset('images/brand/favicon.svg') }}" sizes="any" type="image/svg+xml">
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</head>
	<body class="bg-page text-content font-body flex flex-col min-h-dvh">
		{{ include('header.html.twig') }}
		<main class="grow">
            {% block body %}
            {% endblock %}
		</main>
		{{ include('footer.html.twig') }}
    </body>
</html>
